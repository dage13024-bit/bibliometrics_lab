Title = {Diffusion model for change detection in Sentinel-2 imagery},
Journal = {IEEE GEOSCIENCE AND REMOTE SENSING LETTERS},
Volume = {33},
Issue = {14},
Pages = {83475},
Year = {2026},
Abstract = {Change detection plays a critical role in environmental monitoring and urban management, yet it remains challenging due to seasonal variations, registration errors and heterogeneous land surfaces. In this study, we propose a prompt learning framework that exploits Sentinel-2 imagery to detect changed regions at multiple time steps. The proposed framework integrates multi-scale feature fusion, hard negative mining and a lightweight post-processing module to suppress false alarms caused by illumination and phenology differences. Experiments were conducted on three public benchmarks and one newly collected dataset covering urban, agricultural and coastal scenes. Results show that the proposed method achieves an overall accuracy of 87.7 percent, an F1 score of 86.6 percent and a kappa coefficient of 87.4 percent, outperforming several state of the art baselines while keeping the inference cost acceptable for large area mapping. Ablation studies further confirm that the new design choices, including attention based aggregation and self-supervised pretraining, are essential for robust transfer across sensors and regions.},
Affiliation = {Huang, Xin (Huang, Xin)[1], Wuhan Univ, Sch Remote Sensing & Informat Engn, Wuhan, Peoples R China. Shi, Wenzhong (Shi, Wenzhong)[2], Hong Kong Polytech Univ, Dept Land Surveying & Geoinformat, Hong Kong, Peoples R China. Lin, Ning (Lin, Ning)[3], Tongji Univ, Coll Surveying & Geoinformat, Shanghai, Peoples R China. Yuan, Anna (Yuan, Anna)[4], China Univ Geosci, Sch Geog & Informat Engn, Wuhan, Peoples R China. Huang, Peng (Huang, Peng)[5], Chinese Acad Sci, Aerosp Informat Res Inst, Beijing, Peoples R China},
Times-Cited = {2},
DOI = {10.1016/j.rse.2026.100716},
Language = {English},
