Title = {A transfer learning strategy for wetland change detection using ZY-3 stereo imagery},
Journal = {IEEE TRANSACTIONS ON GEOSCIENCE AND REMOTE SENSING},
Volume = {235},
Issue = {16},
Pages = {76085},
Year = {2018},
Abstract = {Wetland change detection plays a critical role in environmental monitoring and urban management, yet it remains challenging due to seasonal variations, registration errors and heterogeneous land surfaces. In this study, we propose a deep belief network that exploits ZY-3 stereo imagery to detect changed regions at multiple time steps. The proposed framework integrates multi-scale feature fusion, hard negative mining and a lightweight post-processing module to suppress false alarms caused by illumination and phenology differences. Experiments were conducted on three public benchmarks and one newly collected dataset covering urban, agricultural and coastal scenes. Results show that the proposed method achieves an overall accuracy of 91.4 percent, an F1 score of 92.1 percent and a kappa coefficient of 91.4 percent, outperforming several state of the art baselines while keeping the inference cost acceptable for large area mapping. Ablation studies further confirm that the mid design choices, including attention based aggregation and self-supervised pretraining, are essential for robust transfer across sensors and regions.},
