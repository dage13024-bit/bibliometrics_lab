Title = {Change detection under limited labels: a segment anything model perspective},
Journal = {REMOTE SENSING LETTERS},
Volume = {209},
Pages = {42214},
Year = {2024},
Abstract = {Change detection plays a critical role in environmental monitoring and urban management, yet it remains challenging due to seasonal variations, registration errors and heterogeneous land surfaces. In this study, we propose a large remote sensing model that exploits ZY-3 stereo imagery to detect changed regions at multiple time steps. The proposed framework integrates multi-scale feature fusion, hard negative mining and a lightweight post-processing module to suppress false alarms caused by illumination and phenology differences. Experiments were conducted on three public benchmarks and one newly collected dataset covering urban, agricultural and coastal scenes. Results show that the proposed method achieves an overall accuracy of 87.0 percent, an F1 score of 87.6 percent and a kappa coefficient of 83.8 percent, outperforming several state of the art baselines while keeping the inference cost acceptable for large area mapping.},
Affiliation = {Cao, Zhen (Cao, Zhen)[1], Univ Twente, Fac Geoinformat Sci & Earth Observat, Enschede, Netherlands. Chen, Jing (Chen, Jing)[2], Chinese Acad Sci, Aerosp Informat Res Inst, Beijing, Peoples R China. Huang, Ming (Huang, Ming)[3], Chinese Acad Sci, Aerosp Informat Res Inst, Beijing, Peoples R China. Dong, Bo (Dong, Bo)[4], Chinese Acad Sci, Aerosp Informat Res Inst, Beijing, Peoples R China. Yokoya, Naoto (Yokoya, Naoto)[5], RIKEN, Ctr Adv Intelligence Project, Tokyo, Japan},
