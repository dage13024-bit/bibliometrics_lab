@article{WOS:2015000000001,
Author = {Silva, Xin and Tang, Kai and Bovolo, Francesca and Gamba, Paolo},
Title = {Automatic forest disturbance detection with spectral mixture analysis and multitemporal SAR imagery},
Journal = {REMOTE SENSING OF ENVIRONMENT},
Volume = {310},
Issue = {1},
Pages = {47309},
Year = {2015},
Abstract = {Forest disturbance detection plays a critical role in environmental monitoring and urban management, yet it remains challenging due to seasonal variations, registration errors and heterogeneous land surfaces. In this study, we propose a markov random field model that exploits multitemporal SAR imagery to detect changed regions at multiple time steps. The proposed framework integrates multi-scale feature fusion, hard negative mining and a lightweight post-processing module to suppress false alarms caused by illumination and phenology differences. Experiments were conducted on three public benchmarks and one newly collected dataset covering urban, agricultural and coastal scenes. Results show that the proposed method achieves an overall accuracy of 90.5 percent, an F1 score of 92.3 percent and a kappa coefficient of 73.2 percent, outperforming several state of the art baselines while keeping the inference cost acceptable for large area mapping. Ablation studies further confirm that the early design choices, including attention based aggregation and self-supervised pretraining, are essential for robust transfer across sensors and regions.},
Affiliation = {Silva, Xin (Silva, Xin)[1], China Univ Geosci, Sch Geog & Informat Engn, Wuhan, Peoples R China. Tang, Kai (Tang, Kai)[2], Indian Inst Technol, Dept Civil Engn, Mumbai, India. Bovolo, Francesca (Bovolo, Francesca)[3], Fdn Bruno Kessler, Remote Sensing Unit, Trento, Italy. Gamba, Paolo (Gamba, Paolo)[4], Univ Pavia, Dept Elect Comp & Biomed Engn, Pavia, Italy},
Times-Cited = {69},
