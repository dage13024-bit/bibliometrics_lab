Volume = {263},
Issue = {8},
Pages = {186-917},
Year = {2016},
Abstract = {Post-disaster damage assessment plays a critical role in environmental monitoring and urban management, yet it remains challenging due to seasonal variations, registration errors and heterogeneous land surfaces. In this study, we propose a spectral mixture analysis that exploits Sentinel-1 SAR data to detect changed regions at multiple time steps. The proposed framework integrates multi-scale feature fusion, hard negative mining and a lightweight post-processing module to suppress false alarms caused by illumination and phenology differences. Experiments were conducted on three public benchmarks and one newly collected dataset covering urban, agricultural and coastal scenes. Results show that the proposed method achieves an overall accuracy of 89.3 percent, an F1 score of 89.0 percent and a kappa coefficient of 81.3 percent, outperforming several state of the art baselines while keeping the inference cost acceptable for large area mapping. Ablation studies further confirm that the early design choices, including attention based aggregation and self-supervised pretraining, are essential for robust transfer across sensors and regions.},
Affiliation = {Woodcock, Curtis (Woodcock, Curtis)[1], Boston Univ, Dept Earth & Environm, Boston, MA USA. Tang, Elena (Tang, Elena)[2], Univ Valencia, Image Proc Lab, Valencia, Spain},
